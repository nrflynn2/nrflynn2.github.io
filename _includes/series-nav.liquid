{% assign series_info = site.data.series[page.series] %}
{% for series_post in include.posts %}
  {% if series_post.url == page.url %}{% assign series_part = forloop.index %}{% endif %}
{% endfor %}
<nav class="series-nav" aria-label="{{ page.series }} series">
  <div class="series-nav__title">{{ page.series }} series &middot; Part {{ series_part }} of {{ include.posts.size }}</div>
  {% if series_info.note %}
    <div class="series-nav__note">{{ series_info.note | markdownify }}</div>
  {% endif %}
  <details>
    <summary>All posts in this series</summary>
    <ol>
      {% for series_post in include.posts %}
        <li>
          {% if series_post.url == page.url %}
            <span class="series-nav__current">{{ series_post.title }}</span>
          {% else %}
            <a href="{{ series_post.url | relative_url }}">{{ series_post.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </details>
</nav>
